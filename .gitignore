# PlatformIO build output and local configuration
firmware/.pio/
firmware/.pioenvs/
firmware/.piolibdeps/
firmware/.clangd/

# Python bytecode cache (M7P4: check_storage_layout.py imports
# patch_internalfs.py via importlib during every real PlatformIO build)
__pycache__/
*.pyc

# IDE and editor files
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

# Operating system and temporary files
.DS_Store
Thumbs.db
*.tmp
*.log

# Real local secrets (keep example/template files versioned)
.env
.env.*
!.env.example
*.pem
*.key
secrets/
