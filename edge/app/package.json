{
  "name": "orun-edge-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "ORUN phone app: field map, herd, events and network over the phone ledger (BLE + USB Gateway link, confirmed hand-off, server upload).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "android": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capawesome-team/capacitor-android-foreground-service": "8.1.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@leeskies/capacitor-usb-serial": "0.2.0",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@phosphor-icons/react": "2.1.10",
    "maplibre-gl": "6.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
